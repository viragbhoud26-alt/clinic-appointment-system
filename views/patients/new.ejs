<!DOCTYPE html>
<html>
<head>
  <title>XYZ Clinic — Add Patient</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing-dark.css">
</head>
<body class="dark-theme">
  <div class="dc-wrap">
    <%- include('../partials/nav') %>
    <p class="dc-eyebrow">Records</p>
    <h1 class="dc-page-title">Add Patient</h1>
    <form class="dc-form" action="/patients" method="POST" style="margin-top:24px;">
      <label class="dc-label">Full name</label>
      <input class="dc-input" name="name" required>
      <label class="dc-label">Phone</label>
      <input class="dc-input" name="phone">
      <label class="dc-label">Email</label>
      <input class="dc-input" name="email" type="email">
      <label class="dc-label">Date of birth</label>
      <input class="dc-input" name="date_of_birth" type="date">
      <button type="submit" class="dc-btn-gold" style="margin-top:28px;">Save</button>
    </form>
    <a href="/patients" class="dc-back-link">← Back</a>
  </div>
</body>
</html>
