<!DOCTYPE html>
<html>
<head>
  <title>XYZ Clinic — Add Doctor</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing-dark.css">
</head>
<body class="dark-theme">
  <div class="dc-wrap">
    <%- include('../partials/nav') %>
    <p class="dc-eyebrow">Staff</p>
    <h1 class="dc-page-title">Add Doctor</h1>
    <form class="dc-form" action="/doctors" method="POST" style="margin-top:24px;">
      <label class="dc-label">Full name</label>
      <input class="dc-input" name="name" required>
      <label class="dc-label">Specialization</label>
      <input class="dc-input" name="specialization">
      <label class="dc-label">Available from</label>
      <input class="dc-input" name="available_from" type="time" required>
      <label class="dc-label">Available to</label>
      <input class="dc-input" name="available_to" type="time" required>
      <button type="submit" class="dc-btn-gold" style="margin-top:28px;">Save</button>
    </form>
    <a href="/doctors" class="dc-back-link">← Back</a>
  </div>
</body>
</html>
