<!DOCTYPE html>
<html>
<head>
  <title>XYZ Clinic — Doctors</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/landing-dark.css">
</head>
<body class="dark-theme">
  <div class="dc-wrap">
    <%- include('../partials/nav') %>
    <p class="dc-eyebrow">Staff</p>
    <div class="dc-page-header">
      <h1 class="dc-page-title">Doctors</h1>
      <a href="/doctors/new" class="dc-btn-gold">+ Add doctor</a>
    </div>
    <div class="dc-table-wrap">
      <table class="dc-table">
        <tr><th>Name</th><th>Specialization</th><th>Available from</th><th>Available to</th></tr>
        <% doctors.forEach(d => { %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.specialization %></td>
          <td><%= d.available_from %></td>
          <td><%= d.available_to %></td>
        </tr>
        <% }) %>
      </table>
    </div>
  </div>
</body>
</html>
