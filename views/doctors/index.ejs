<!DOCTYPE html>
<html>
<head>
  <title>XYZ Clinic — Doctors</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <p class="eyebrow">Staff</p>
  <div class="page-header-row">
    <h1>Doctors</h1>
    <a href="/doctors/new" class="btn-primary">+ Add doctor</a>
  </div>
  <table>
    <tr><th>Name</th><th>Specialization</th><th>Available from</th><th>Available to</th></tr>
    <% doctors.forEach(d => { %>
    <tr>
      <td><%= d.name %></td>
      <td><%= d.specialization %></td>
      <td><%= d.available_from %></td>
      <td><%= d.available_to %></td>
    </tr>
    <% }) %>
  </table>
</body>
</html>
